FROM python:3.11-slim
WORKDIR /workspace
RUN apt-get update && apt-get install -y curl git && rm -rf /var/lib/apt/lists/*
RUN curl -L -o /usr/local/bin/opa https://openpolicyagent.org/downloads/v0.61.0/opa_linux_amd64_static && chmod +x /usr/local/bin/opa
RUN pip install --no-cache-dir pydantic pyyaml opentelemetry-api opentelemetry-sdk pytest hypothesis textual httpx
